{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure (Windows)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build_${fileDirnameBasename}",
                "-G",
                "Visual Studio 17 2022",
                "-DAOC_DAY=1"
            ],
        },
        {
            "label": "CMake: build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build_${fileDirnameBasename}",
                "--config",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
        }
    ]
}